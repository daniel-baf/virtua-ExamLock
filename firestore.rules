rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Teachers can read/write their own sessions
    match /sessions/{sessionId} {
      allow read, write: if request.auth != null
        && request.auth.token.role == 'teacher'
        && (resource == null || resource.data.teacherId == request.auth.uid);
    }

    // Students can read their own student doc
    match /students/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // writes go through server (Admin SDK bypasses rules)
    }

    // Admins can read all user profiles; users can read their own
    match /users/{uid} {
      allow read: if request.auth != null
        && (request.auth.token.role == 'admin' || request.auth.uid == uid);
      // Writes go through server (Admin SDK bypasses rules)
    }

    // No direct client access to events or screenshots — server only
    match /events/{id} {
      allow read, write: if false;
    }
    match /screenshots/{id} {
      allow read, write: if false;
    }
  }
}
