NODE_ENV=development
PORT=8080

# GCP project (ADC se resuelve solo: gcloud auth application-default login en local, service account en Cloud Run)
GCP_PROJECT_ID=your-project-id
FIRESTORE_DATABASE=(default)

# Cloud Storage
GCS_BUCKET=examlock-screenshots

# JWT secret for container session tokens (generate with: openssl rand -hex 32)
JWT_SECRET=replace_with_random_secret

# Allowed origins for CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,https://your-dashboard.web.app
